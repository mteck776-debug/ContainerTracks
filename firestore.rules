rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Only the emails listed below can read or change yard data.
// Add or remove people by editing the list and publishing again.

service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email in [
          'you@example.com'
        ];
    }

    match /{collection}/{docId} {
      allow read, write: if allowed()
        && collection in ['bays', 'containers', 'prefixes', 'materials', 'trucks', 'history'];
    }
  }
}
