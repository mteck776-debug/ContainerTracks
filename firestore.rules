rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// The app signs in silently (anonymous sign-in), so anyone who opens the app can use it.
// Data must be one of the app's collections and documents are size-limited.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{docId} {
      allow read: if request.auth != null
        && collection in ['bays', 'containers', 'prefixes', 'materials', 'trucks', 'history'];
      allow delete: if request.auth != null
        && collection in ['containers', 'prefixes', 'materials', 'trucks', 'history'];
      allow create, update: if request.auth != null
        && collection in ['bays', 'containers', 'prefixes', 'materials', 'trucks', 'history']
        && request.resource.data.size() < 40;
    }
  }
}
